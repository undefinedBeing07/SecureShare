# Server Port
PORT=5000

# Security / JWT Secret Key
JWT_SECRET=secureshare-enterprise-jwt-secret-2026

# Storage Directory (Local simulated R2 storage path)
STORAGE_DIR=./storage_r2

# Cloudflare R2 Credentials (Optional - uses local simulated storage if left blank)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=secure-files
R2_ENDPOINT=

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/secureshare?retryWrites=true&w=majority

# SMTP Email Delivery Provider Settings (Required for Real Email OTP Delivery)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# EMAIL_FROM=Secure Share <your-email@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Secure Share <no-reply@secureshare.io>"
